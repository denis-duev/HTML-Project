                  </div>
                </div>
              </div>
            </div>
          `}).join("")}
        </div>
      </div>
    `}function ht(e){let t=e.data;return`
      <div class="jim2-p-section">
        <button class="jim2-variant-back" id="jim2-variant-back">\u2190 ${g().backToProducts}</button>
        <div class="jim2-p-title">${u(t.name)}</div>
        ${t.price?`<div class="jim2-variant-price">${g().priceFrom} ${u(t.price)}</div>`:""}
        <div class="jim2-variant-stock">\u25CF ${g().inStock}</div>
        <div class="jim2-variant-picker">
          ${t.options.map(a=>`
            <div class="jim2-variant-group">
              <label class="jim2-variant-label">${u(a.label)}</label>
              <select class="jim2-variant-select">
                <option value="">${g().pickVariant.replace("{opt}",u(a.label.toLowerCase()))}</option>
                ${a.values.map(n=>`<option value="${u(n.uid)}">${u(n.label)}</option>`).join("")}
              </select>
            </div>
          `).join("")}
          <button class="jim2-variant-confirm" id="jim2-variant-confirm">
            ${g().addToCart} \u{1F6D2}
          </button>
        </div>
      </div>
    `}function vt(e){let t=e.data;return`
      <div class="jim2-p-section">
        <div class="jim2-p-title">\u{1F4E6} ${g().orderPanelTitle} ${u(t.order_id)}</div>
        <div class="jim2-p-order">
          <div class="jim2-p-order-status">
            <span class="jim2-p-status-badge">${u(t.status)}</span>
            ${t.carrier?`<span class="jim2-p-carrier">${u(t.carrier)}</span>`:""}
          </div>
          ${t.items?`
            <div class="jim2-p-order-items">
              <div class="jim2-p-subtitle">${g().orderItems}</div>
              ${t.items.map(a=>`<div class="jim2-p-order-item">\u2022 ${u(a)}</div>`).join("")}
            </div>
          `:""}
          ${t.total?`<div class="jim2-p-order-total">${g().orderTotal} ${u(t.total)} ${u(t.currency||"EUR")}</div>`:""}
        </div>
      </div>
    `}function bt(e){return`
      <div class="jim2-p-section">
        <button class="jim2-variant-back" id="jim2-variant-back">\u2190 ${g().backToProducts}</button>
        <div class="jim2-p-title">\u2705 ${g().addedToCart}</div>
        <div class="jim2-p-cart-added">
          <div class="jim2-p-cart-product">${u(e.data.name)}</div>
          <a href="/checkout/cart" class="jim2-go-to-cart">${g().goToCart} \u2192</a>
          ${i.cartItems.length>1?`
            <div class="jim2-p-cart-items">
              <div class="jim2-p-subtitle">${g().addedViaJim} (${i.cartItems.length}):</div>
              ${i.cartItems.map(t=>`<div class="jim2-p-order-item">\u2022 ${u(t)}</div>`).join("")}
            </div>
          `:""}
        </div>
      </div>
    `}function kt(){let e=document.getElementById("jim2-a-messages");e&&(e.scrollTop=e.scrollHeight)}function M(e,t){if(!N()&&e){i.pendingPrefill=e,ie("",t);return}ie(e,t)}document.addEventListener("click",e=>{let t=e.target.closest("[data-action='open']");if(!t)return;e.preventDefault(),e.stopPropagation();let a=t.dataset.prefill||"",n=t.dataset.mode||null;M(a,n)}),document.addEventListener("keydown",e=>{e.key==="Escape"&&i.isOpen&&S()});let ft=()=>window.matchMedia("(max-width: 768px)").matches;document.addEventListener("click",e=>{let t=e.target.closest("a.jim2-msg-link[data-product-link]");t&&ft()&&(t.setAttribute("target","_self"),S())});let jt=35e3,yt=[8e3,16e3],E={order:{sk:["H\u013Ead\xE1m tvoju objedn\xE1vku v syst\xE9me\u2026","Kontrolujem stav u prepravcu, chv\xED\u013Eu to potrv\xE1\u2026"],cs:["Hled\xE1m tvoji objedn\xE1vku v syst\xE9mu\u2026","Kontroluji stav u p\u0159epravce, chv\xEDli to potrv\xE1\u2026"],hu:["Keresem a rendel\xE9sed a rendszerben\u2026","Ellen\u0151rz\xF6m a k\xE9zbes\xEDt\u0151n\xE9l, kis id\u0151be telik\u2026"],de:["Ich suche deine Bestellung im System\u2026","Ich pr\xFCfe den Status beim Versand, einen Moment bitte\u2026"],sl:["I\u0161\u010Dem va\u0161o naro\u010Dilo v sistemu\u2026","Preverjam stanje pri prevozniku, to bo trajalo trenutek\u2026"],ro:["Caut comanda ta \xEEn sistem\u2026","Verific statusul la curier, va dura un moment\u2026"],bg:["\u0422\u044A\u0440\u0441\u044F \u043F\u043E\u0440\u044A\u0447\u043A\u0430\u0442\u0430 \u0442\u0438 \u0432 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0430\u2026","\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0432\u0430\u043C \u0441\u0442\u0430\u0442\u0443\u0441\u0430 \u043F\u0440\u0438 \u043A\u0443\u0440\u0438\u0435\u0440\u0430, \u0449\u0435 \u043E\u0442\u043D\u0435\u043C\u0435 \u043C\u0430\u043B\u043A\u043E\u2026"],pl:["Szukam twojego zam\xF3wienia w systemie\u2026","Sprawdzam status u przewo\u017Anika, to chwil\u0119 potrwa\u2026"],hr:["Tra\u017Eim va\u0161u narud\u017Ebu u sustavu\u2026","Provjeravam status kod dostavlja\u010Da, trenutak\u2026"],it:["Sto cercando il tuo ordine nel sistema\u2026","Sto verificando lo stato con il corriere, un momento\u2026"],uk:["\u0428\u0443\u043A\u0430\u044E \u0432\u0430\u0448\u0435 \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F \u0432 \u0441\u0438\u0441\u0442\u0435\u043C\u0456\u2026","\u041F\u0435\u0440\u0435\u0432\u0456\u0440\u044F\u044E \u0441\u0442\u0430\u0442\u0443\u0441 \u0443 \u043F\u0435\u0440\u0435\u0432\u0456\u0437\u043D\u0438\u043A\u0430, \u0437\u0430\u0447\u0435\u043A\u0430\u0439\u0442\u0435 \u0445\u0432\u0438\u043B\u0438\u043D\u043A\u0443\u2026"],nl:["Ik zoek je bestelling in het systeem\u2026","Ik controleer de status bij de bezorger, even geduld\u2026"],fr:["Je recherche votre commande dans le syst\xE8me\u2026","Je v\xE9rifie le statut aupr\xE8s du transporteur, un instant\u2026"],en:["Looking up your order in our system\u2026","Checking with the carrier, this may take a moment\u2026"]},product:{sk:["Prezer\xE1m si produktov\xFD katal\xF3g\u2026","Vyber\xE1m pre teba najlep\u0161ie mo\u017Enosti\u2026"],cs:["Prohl\xED\u017E\xEDm si produktov\xFD katalog\u2026","Vyb\xEDr\xE1m pro tebe nejlep\u0161\xED mo\u017Enosti\u2026"],hu:["\xC1tn\xE9zem a term\xE9kkatal\xF3gust\u2026","A legjobb lehet\u0151s\xE9geket keresem neked\u2026"],de:["Ich durchsuche unseren Produktkatalog\u2026","Ich w\xE4hle die besten Optionen f\xFCr dich aus\u2026"],sl:["Pregledavam katalog izdelkov\u2026","Izbiram najbolj\u0161e mo\u017Enosti za vas\u2026"],ro:["R\u0103sfoiesc catalogul de produse\u2026","Aleg cele mai bune op\u021Biuni pentru tine\u2026"],bg:["\u0420\u0430\u0437\u0433\u043B\u0435\u0436\u0434\u0430\u043C \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432\u0438\u044F \u043A\u0430\u0442\u0430\u043B\u043E\u0433\u2026","\u0418\u0437\u0431\u0438\u0440\u0430\u043C \u043D\u0430\u0439-\u0434\u043E\u0431\u0440\u0438\u0442\u0435 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0438 \u0437\u0430 \u0442\u0435\u0431\u2026"],pl:["Przegl\u0105dam katalog produkt\xF3w\u2026","Wybieram dla ciebie najlepsze opcje\u2026"],hr:["Pregledavam katalog proizvoda\u2026","Biram najbolje mogu\u0107nosti za vas\u2026"],it:["Sto sfogliando il catalogo prodotti\u2026","Sto scegliendo le migliori opzioni per te\u2026"],uk:["\u041F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u0430\u044E \u043A\u0430\u0442\u0430\u043B\u043E\u0433 \u0442\u043E\u0432\u0430\u0440\u0456\u0432\u2026","\u0412\u0438\u0431\u0438\u0440\u0430\u044E \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0456 \u0432\u0430\u0440\u0456\u0430\u043D\u0442\u0438 \u0434\u043B\u044F \u0432\u0430\u0441\u2026"],nl:["Ik blader door de productcatalogus\u2026","Ik kies de beste opties voor je uit\u2026"],fr:["Je parcours le catalogue de produits\u2026","Je s\xE9lectionne les meilleures options pour vous\u2026"],en:["Searching through our product catalog\u2026","Picking the best options for you\u2026"]},faq:{sk:["Pozer\xE1m sa do n\xE1\u0161ho manu\xE1lu\u2026","E\u0161te chv\xED\u013Eku, overujem odpove\u010F\u2026"],cs:["D\xEDv\xE1m se do na\u0161eho manu\xE1lu\u2026","Je\u0161t\u011B chvilku, ov\u011B\u0159uji odpov\u011B\u010F\u2026"],hu:["Megn\xE9zem a k\xE9zik\xF6nyv\xFCnket\u2026","M\xE9g egy pillanat, ellen\u0151rz\xF6m a v\xE1laszt\u2026"],de:["Ich schaue in unser Handbuch\u2026","Einen Moment noch, ich pr\xFCfe die Antwort\u2026"],sl:["I\u0161\u010Dem v na\u0161i bazi znanja\u2026","Trenutek, preverjam odgovor\u2026"],ro:["Consult baza noastr\u0103 de cuno\u0219tin\u021Be\u2026","Un moment, verific r\u0103spunsul\u2026"],bg:["\u0420\u0430\u0437\u0433\u043B\u0435\u0436\u0434\u0430\u043C \u043D\u0430\u0448\u0430\u0442\u0430 \u0431\u0430\u0437\u0430 \u0437\u043D\u0430\u043D\u0438\u044F\u2026","\u041C\u043E\u043C\u0435\u043D\u0442, \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0432\u0430\u043C \u043E\u0442\u0433\u043E\u0432\u043E\u0440\u0430\u2026"],pl:["Sprawdzam nasz\u0105 baz\u0119 wiedzy\u2026","Chwileczk\u0119, weryfikuj\u0119 odpowied\u017A\u2026"],hr:["Pregledavam na\u0161u bazu znanja\u2026","Trenutak, provjeravam odgovor\u2026"],it:["Sto consultando la nostra knowledge base\u2026","Un momento, sto verificando la risposta\u2026"],uk:["\u0428\u0443\u043A\u0430\u044E \u0432 \u043D\u0430\u0448\u0456\u0439 \u0431\u0430\u0437\u0456 \u0437\u043D\u0430\u043D\u044C\u2026","\u0425\u0432\u0438\u043B\u0438\u043D\u043A\u0443, \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u044F\u044E \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C\u2026"],nl:["Ik raadpleeg onze kennisbank\u2026","Even geduld, ik controleer het antwoord\u2026"],fr:["Je consulte notre base de connaissances\u2026","Un moment, je v\xE9rifie la r\xE9ponse\u2026"],en:["Looking into our knowledge base\u2026","One moment, verifying the answer\u2026"]},generic:{sk:["E\u0161te chv\xED\u013Eku, prehrab\xE1vam sa v arch\xEDvoch\u2026","St\xE1le na tom pracujem, \u010Fakujem za trpezlivos\u0165\u2026"],cs:["Je\u0161t\u011B chvilku, hrabu se v archivech\u2026","St\xE1le na tom pracuji, d\u011Bkuji za trp\u011Blivost\u2026"],hu:["M\xE9g egy pillanat, kutatok az arch\xEDvumokban\u2026","M\xE9g mindig dolgozom rajta, k\xF6sz\xF6n\xF6m a t\xFCrelmed\u2026"],de:["Einen Moment, ich st\xF6bere in den Archiven\u2026","Ich arbeite noch daran, danke f\xFCr deine Geduld\u2026"],sl:["Trenutek, kopam po arhivih\u2026","\u0160e vedno delam na tem, hvala za potrpljenje\u2026"],ro:["Un moment, caut prin arhive\u2026","\xCEnc\u0103 lucrez la asta, mul\u021Bumesc pentru r\u0103bdare\u2026"],bg:["\u041C\u043E\u043C\u0435\u043D\u0442, \u0440\u043E\u0432\u044F \u0438\u0437 \u0430\u0440\u0445\u0438\u0432\u0438\u0442\u0435\u2026","\u0412\u0441\u0435 \u043E\u0449\u0435 \u0440\u0430\u0431\u043E\u0442\u044F \u043F\u043E \u0442\u043E\u0432\u0430, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0437\u0430 \u0442\u044A\u0440\u043F\u0435\u043D\u0438\u0435\u0442\u043E\u2026"],pl:["Chwileczk\u0119, przeszukuj\u0119 archiwa\u2026","Ci\u0105gle nad tym pracuj\u0119, dzi\u0119kuj\u0119 za cierpliwo\u015B\u0107\u2026"],hr:["Trenutak, pretra\u017Eujem arhive\u2026","Jo\u0161 uvijek radim na tome, hvala na strpljenju\u2026"],it:["Un momento, sto cercando negli archivi\u2026","Ci sto ancora lavorando, grazie per la pazienza\u2026"],uk:["\u0425\u0432\u0438\u043B\u0438\u043D\u043A\u0443, \u043A\u043E\u043F\u0430\u044E\u0441\u044F \u0432 \u0430\u0440\u0445\u0456\u0432\u0430\u0445\u2026","\u0429\u0435 \u043F\u0440\u0430\u0446\u044E\u044E \u043D\u0430\u0434 \u0446\u0438\u043C, \u0434\u044F\u043A\u0443\u044E \u0437\u0430 \u0442\u0435\u0440\u043F\u0456\u043D\u043D\u044F\u2026"],nl:["Even geduld, ik doorzoek de archieven\u2026","Ik werk er nog aan, bedankt voor je geduld\u2026"],fr:["Un instant, je fouille dans les archives\u2026","Je travaille encore dessus, merci de votre patience\u2026"],en:["One moment, digging through the archives\u2026","Still working on it, thanks for your patience\u2026"]}},ge={sk:"Ospravedl\u0148ujem sa, odpove\u010F mi trv\xE1 dlh\u0161ie, ako by mala. Sk\xFAs to pros\xEDm o chv\xED\u013Eu znova, alebo kontaktuj n\xE1\u0161 z\xE1kazn\xEDcky servis na info@gymbeam.sk.",cs:"Omlouv\xE1m se, odpov\u011B\u010F mi trv\xE1 d\xE9le, ne\u017E by m\u011Bla. Zkus to pros\xEDm za chv\xEDli znovu, nebo kontaktuj na\u0161i z\xE1kaznickou podporu na info@gymbeam.cz.",hu:"Eln\xE9z\xE9st, a v\xE1lasz tov\xE1bb tart a kellet\xE9n\xE9l. K\xE9rlek, pr\xF3b\xE1ld \xFAjra kicsit k\xE9s\u0151bb, vagy vedd fel a kapcsolatot \xFCgyf\xE9lszolg\xE1latunkkal.",de:"Entschuldigung, die Antwort dauert l\xE4nger als erwartet. Bitte versuche es in K\xFCrze erneut oder kontaktiere unseren Kundenservice.",sl:"Opravi\u010Dujem se, odgovor traja dlje kot bi moral. Prosim, poskusite znova \u010Dez trenutek ali kontaktirajte na\u0161o podporo strankam.",ro:"\xCEmi pare r\u0103u, r\u0103spunsul dureaz\u0103 mai mult dec\xE2t ar trebui. Te rog \xEEncearc\u0103 din nou \xEEn scurt timp sau contacteaz\u0103 serviciul nostru clien\u021Bi.",bg:"\u0421\u044A\u0436\u0430\u043B\u044F\u0432\u0430\u043C, \u043E\u0442\u0433\u043E\u0432\u043E\u0440\u044A\u0442 \u043C\u0438 \u043E\u0442\u043D\u0435\u043C\u0430 \u043F\u043E\u0432\u0435\u0447\u0435 \u043E\u0442 \u043E\u0447\u0430\u043A\u0432\u0430\u043D\u043E\u0442\u043E. \u041C\u043E\u043B\u044F, \u043E\u043F\u0438\u0442\u0430\u0439\u0442\u0435 \u043E\u0442\u043D\u043E\u0432\u043E \u0441\u043B\u0435\u0434 \u043C\u0430\u043B\u043A\u043E \u0438\u043B\u0438 \u0441\u0435 \u0441\u0432\u044A\u0440\u0436\u0435\u0442\u0435 \u0441 \u043D\u0430\u0448\u0438\u044F \u043A\u043B\u0438\u0435\u043D\u0442\u0441\u043A\u0438 \u0441\u0435\u0440\u0432\u0438\u0437.",pl:"Przepraszam, odpowied\u017A trwa d\u0142u\u017Cej ni\u017C powinna. Spr\xF3buj ponownie za chwil\u0119 lub skontaktuj si\u0119 z nasz\u0105 obs\u0142ug\u0105 klienta.",hr:"Ispri\u010Davam se, odgovor traje dulje nego \u0161to bi trebao. Molim poku\u0161ajte ponovo za trenutak ili kontaktirajte na\u0161u korisni\u010Dku podr\u0161ku.",it:"Mi dispiace, la risposta sta richiedendo pi\xF9 tempo del previsto. Riprova tra poco o contatta il nostro servizio clienti.",uk:"\u0412\u0438\u0431\u0430\u0447\u0442\u0435, \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C \u0437\u0430\u0439\u043C\u0430\u0454 \u0431\u0456\u043B\u044C\u0448\u0435 \u0447\u0430\u0441\u0443, \u043D\u0456\u0436 \u043E\u0447\u0456\u043A\u0443\u0432\u0430\u043B\u043E\u0441\u044F. \u0421\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437 \u0447\u0435\u0440\u0435\u0437 \u043C\u0438\u0442\u044C \u0430\u0431\u043E \u0437\u0432\u0435\u0440\u043D\u0456\u0442\u044C\u0441\u044F \u0434\u043E \u043D\u0430\u0448\u043E\u0457 \u0441\u043B\u0443\u0436\u0431\u0438 \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u043A\u0438.",nl:"Sorry, mijn antwoord duurt langer dan verwacht. Probeer het over een moment opnieuw of neem contact op met onze klantenservice.",fr:"D\xE9sol\xE9, ma r\xE9ponse prend plus de temps que pr\xE9vu. Veuillez r\xE9essayer dans un moment ou contacter notre service client.",en:"Sorry, my response is taking longer than expected. Please try again shortly, or contact our customer service."},he={sk:"Prep\xE1\u010D, moment\xE1lne sa mi nedar\xED za\u010Da\u0165 nov\xFA konverz\xE1ciu kv\xF4li technick\xE9mu probl\xE9mu. Sk\xFAs to pros\xEDm nesk\xF4r, alebo nap\xED\u0161 n\xE1\u0161mu z\xE1kazn\xEDckemu servisu.",cs:"Omlouv\xE1m se, moment\xE1ln\u011B se mi kv\u016Fli technick\xE9mu probl\xE9mu neda\u0159\xED zah\xE1jit novou konverzaci. Zkus to pros\xEDm pozd\u011Bji, nebo napi\u0161 na\u0161\xED z\xE1kaznick\xE9 podpo\u0159e.",hu:"Eln\xE9z\xE9st, egy technikai probl\xE9ma miatt jelenleg nem tudok \xFAj besz\xE9lget\xE9st ind\xEDtani. K\xE9rlek, pr\xF3b\xE1ld \xFAjra k\xE9s\u0151bb, vagy \xEDrj \xFCgyf\xE9lszolg\xE1latunknak.",de:"Entschuldigung, wegen eines technischen Problems kann ich gerade keine neue Unterhaltung starten. Bitte versuche es sp\xE4ter erneut oder schreibe unserem Kundenservice.",sl:"Opravi\u010Dujem se, zaradi tehni\u010Dne te\u017Eave trenutno ne morem za\u010Deti novega pogovora. Poskusite znova pozneje ali pi\u0161ite na\u0161i podpori strankam.",ro:"\xCEmi pare r\u0103u, din cauza unei probleme tehnice nu pot \xEEncepe momentan o conversa\u021Bie nou\u0103. Te rog \xEEncearc\u0103 mai t\xE2rziu sau scrie serviciului nostru clien\u021Bi.",bg:"\u0421\u044A\u0436\u0430\u043B\u044F\u0432\u0430\u043C, \u043F\u043E\u0440\u0430\u0434\u0438 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C \u0432 \u043C\u043E\u043C\u0435\u043D\u0442\u0430 \u043D\u0435 \u043C\u043E\u0433\u0430 \u0434\u0430 \u0437\u0430\u043F\u043E\u0447\u043D\u0430 \u043D\u043E\u0432 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440. \u041C\u043E\u043B\u044F, \u043E\u043F\u0438\u0442\u0430\u0439\u0442\u0435 \u043F\u043E-\u043A\u044A\u0441\u043D\u043E \u0438\u043B\u0438 \u043F\u0438\u0448\u0435\u0442\u0435 \u043D\u0430 \u043D\u0430\u0448\u0438\u044F \u043A\u043B\u0438\u0435\u043D\u0442\u0441\u043A\u0438 \u0441\u0435\u0440\u0432\u0438\u0437.",pl:"Przepraszam, z powodu problemu technicznego nie mog\u0119 teraz rozpocz\u0105\u0107 nowej rozmowy. Spr\xF3buj ponownie p\xF3\u017Aniej lub napisz do naszej obs\u0142ugi klienta.",hr:"Ispri\u010Davam se, zbog tehni\u010Dkog problema trenutno ne mogu zapo\u010Deti novi razgovor. Poku\u0161ajte ponovno kasnije ili pi\u0161ite na\u0161oj korisni\u010Dkoj podr\u0161ci.",it:"Mi dispiace, a causa di un problema tecnico al momento non riesco ad avviare una nuova conversazione. Riprova pi\xF9 tardi o scrivi al nostro servizio clienti.",uk:"\u0412\u0438\u0431\u0430\u0447\u0442\u0435, \u0447\u0435\u0440\u0435\u0437 \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0443 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443 \u044F \u0437\u0430\u0440\u0430\u0437 \u043D\u0435 \u043C\u043E\u0436\u0443 \u0440\u043E\u0437\u043F\u043E\u0447\u0430\u0442\u0438 \u043D\u043E\u0432\u0443 \u0440\u043E\u0437\u043C\u043E\u0432\u0443. \u0421\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u043F\u0456\u0437\u043D\u0456\u0448\u0435 \u0430\u0431\u043E \u043D\u0430\u043F\u0438\u0448\u0456\u0442\u044C \u043D\u0430\u0448\u0456\u0439 \u0441\u043B\u0443\u0436\u0431\u0456 \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u043A\u0438.",nl:"Sorry, door een technisch probleem kan ik op dit moment geen nieuw gesprek starten. Probeer het later opnieuw of schrijf onze klantenservice.",fr:"D\xE9sol\xE9, en raison d'un probl\xE8me technique, je ne peux pas d\xE9marrer une nouvelle conversation pour le moment. Veuillez r\xE9essayer plus tard ou \xE9crire \xE0 notre service client.",en:"Sorry, due to a technical issue I can't start a new conversation right now. Please try again later or contact our customer service."},ve={sk:"sk",cz:"cs",hu:"hu",ro:"ro",bg:"bg",de:"de",at:"de",pl:"pl",hr:"hr",si:"sl",it:"it",ua:"uk",nl:"nl",fr:"fr",ba:"bs",gr:"el",rs:"sr",com:"en"},be=Object.keys(ve),wt=ve,ke={sk:"/content/ochrana-osobnych-udajov",cz:"/content/ochrana-osobnich-udaju",hu:"/content/szemelyes-adatok-vedelme",ro:"/content/conditii-de-prelucrare-a-datelor-cu-caracter-personal",bg:"/content/zashtita-na-lichnite-danni",de:"/content/datenschutz",at:"/content/datenschutz",pl:"/content/polityka-prywatnosci",hr:"/content/zastita-osobnih-podataka",si:"/content/pravilnik-o-zasebnosti",it:"/content/protezione-dei-dati-personali",ua:"/ua/content/politika-konfidencijnosti",com:"/content/privacy-policy",nl:"/content/privacy-policy",fr:"/content/privacy-policy"},J={sk:{intro:"Ahoj, som **Jim**, tvoj AI asistent v GymBeame.",welcome:"S \u010D\xEDm ti pom\xF4\u017Eem?",welcomePdp:"Vid\xEDm, \u017Ee sa pozer\xE1\u0161 na {product}. Chce\u0161 o tomto produkte poveda\u0165 viac, alebo h\u013Ead\xE1\u0161 nie\u010Do in\xE9?",welcomeCategory:"Pom\xF4\u017Eem ti s v\xFDberom. Ak\xFD je tvoj cie\u013E \u2014 naberanie svalov, chudnutie, alebo celkov\xE9 zdravie?",welcomeCart:"Vid\xEDm, \u017Ee m\xE1\u0161 nie\u010Do v ko\u0161\xEDku. Chce\u0161 poradi\u0165 s v\xFDberom, alebo doplni\u0165 nie\u010Do, \u010Do ti m\xF4\u017Ee pom\xF4c\u0165?",welcomeAccount:"Ako ti m\xF4\u017Eem pom\xF4c\u0165?",welcomeBlog:"Chce\u0161, aby som ti odporu\u010Dil produkty s\xFAvisiace s t\xFDm, \u010Do \u010D\xEDta\u0161?",chips:["Stav objedn\xE1vky","Vr\xE1tenie tovaru","Reklam\xE1cia tovaru","Zru\u0161enie objedn\xE1vky","Odpor\xFA\u010Danie produktov"],today:"Dnes",timeNow:"pred chv\xED\u013Eou",timeMin:"pred {n} min",timeHour:"pred {n} h",rateAnswer:"Ohodno\u0165 odpove\u010F",fbGood:"Dobr\xE1 odpove\u010F",fbBad:"Zl\xE1 odpove\u010F",disclaimer:"Jim je AI asistent \xB7 m\xF4\u017Ee sa pom\xFDli\u0165.",privacyLink:"Z\xE1sady ochrany \xFAdajov",placeholder:"Nap\xED\u0161 spr\xE1vu Jimovi\u2026",placeholderConsent:"Pred pokra\u010Dovan\xEDm ude\u013E s\xFAhlas \u2191",gdprTitle:"Sk\xF4r ako za\u010Dneme",gdprBody:"Jim pou\u017E\xEDva AI na zodpovedanie tvojich ot\xE1zok. Konverz\xE1cia m\xF4\u017Ee by\u0165 ulo\u017Een\xE1 pre zlep\u0161enie slu\u017Eby. Viac v {link}.",gdprLink:"z\xE1sad\xE1ch ochrany \xFAdajov",gdprPending:"Tvoja ot\xE1zka: {q} \u2014 odo\u0161lem ju hne\u010F po udelen\xED s\xFAhlasu.",gdprAccept:"S\xFAhlas\xEDm a za\u010Da\u0165",gdprDecline:"Nes\xFAhlas\xEDm",gdprDeclinedTitle:"Bez s\xFAhlasu nem\xF4\u017Eeme pokra\u010Dova\u0165",gdprDeclinedBody:"Pre chat s Jimom je potrebn\xE9 udeli\u0165 s\xFAhlas so spracovan\xEDm spr\xE1v. Ak si si to rozmyslel, m\xF4\u017Ee\u0161 ho udeli\u0165 teraz.",gdprReset:"Udeli\u0165 s\xFAhlas",panelRecommended:"Odpor\xFA\u010Dan\xE9 produkty",addToCart:"Prida\u0165 do ko\u0161\xEDka",priceFrom:"od",loadingPrice:"Na\u010D\xEDtavam\u2026",backToProducts:"Sp\xE4\u0165 na produkty",inStock:"Skladom",pickVariant:"Vyber {opt}",orderPanelTitle:"Objedn\xE1vka",orderItems:"Polo\u017Eky:",orderTotal:"Celkom:",addedToCart:"Pridan\xE9 do ko\u0161\xEDka",goToCart:"Prejs\u0165 do ko\u0161\xEDka",addedViaJim:"Pridan\xE9 cez Jima",discountUpTo:"A\u017D \u2013{n} %"},cs:{intro:"Ahoj, jsem **Jim**, tv\u016Fj AI asistent v GymBeamu.",welcome:"S \u010D\xEDm ti pom\u016F\u017Eu?",welcomePdp:"Vid\xEDm, \u017Ee se d\xEDv\xE1\u0161 na {product}. Chce\u0161 o tomto produktu \u0159\xEDct v\xEDc, nebo hled\xE1\u0161 n\u011Bco jin\xE9ho?",welcomeCategory:"Pom\u016F\u017Eu ti s v\xFDb\u011Brem. Jak\xFD je tv\u016Fj c\xEDl \u2014 nab\xEDr\xE1n\xED sval\u016F, hubnut\xED, nebo celkov\xE9 zdrav\xED?",welcomeCart:"Vid\xEDm, \u017Ee m\xE1\u0161 n\u011Bco v ko\u0161\xEDku. Chce\u0161 poradit s v\xFDb\u011Brem, nebo doplnit n\u011Bco, co ti m\u016F\u017Ee pomoct?",welcomeAccount:"Jak ti m\u016F\u017Eu pomoct?",welcomeBlog:"Chce\u0161, abych ti doporu\u010Dil produkty souvisej\xEDc\xED s t\xEDm, co \u010Dte\u0161?",chips:["Stav objedn\xE1vky","Vr\xE1cen\xED zbo\u017E\xED","Reklamace zbo\u017E\xED","Zru\u0161en\xED objedn\xE1vky","Doporu\u010Den\xED produkt\u016F"],today:"Dnes",timeNow:"p\u0159ed chv\xEDl\xED",timeMin:"p\u0159ed {n} min",timeHour:"p\u0159ed {n} h",rateAnswer:"Ohodno\u0165 odpov\u011B\u010F",fbGood:"Dobr\xE1 odpov\u011B\u010F",fbBad:"\u0160patn\xE1 odpov\u011B\u010F",disclaimer:"Jim je AI asistent \xB7 m\u016F\u017Ee se m\xFDlit.",privacyLink:"Z\xE1sady ochrany \xFAdaj\u016F",placeholder:"Napi\u0161 zpr\xE1vu Jimovi\u2026",placeholderConsent:"P\u0159ed pokra\u010Dov\xE1n\xEDm udel souhlas \u2191",gdprTitle:"Ne\u017E za\u010Dneme",gdprBody:"Jim pou\u017E\xEDv\xE1 AI k zodpov\u011Bzen\xED tv\xFDch ot\xE1zek. Konverzace m\u016F\u017Ee b\xFDt ulo\u017Eena pro zlep\u0161en\xED slu\u017Eby. V\xEDce v {link}.",gdprLink:"z\xE1sad\xE1ch ochrany \xFAdaj\u016F",gdprPending:"Tvoje ot\xE1zka: {q} \u2014 ode\u0161lu ji hned po ud\u011Blen\xED souhlasu.",gdprAccept:"Souhlas\xEDm a za\u010D\xEDt",gdprDecline:"Nesouhlas\xEDm",gdprDeclinedTitle:"Bez souhlasu nem\u016F\u017Eeme pokra\u010Dovat",gdprDeclinedBody:"Pro chat s Jimem je pot\u0159eba ud\u011Blit souhlas se zpracov\xE1n\xEDm zpr\xE1v. Pokud sis to rozmyslel, m\u016F\u017Ee\u0161 ho ud\u011Blit te\u010F.",gdprReset:"Ud\u011Blit souhlas",panelRecommended:"Doporu\u010Den\xE9 produkty",addToCart:"P\u0159idat do ko\u0161\xEDku",priceFrom:"od",loadingPrice:"Na\u010D\xEDt\xE1m\u2026",backToProducts:"Zp\u011Bt na produkty",inStock:"Skladem",pickVariant:"Vyber {opt}",orderPanelTitle:"Objedn\xE1vka",orderItems:"Polo\u017Eky:",orderTotal:"Celkem:",addedToCart:"P\u0159id\xE1no do ko\u0161\xEDku",goToCart:"P\u0159ej\xEDt do ko\u0161\xEDku",addedViaJim:"P\u0159id\xE1no p\u0159es Jima",discountUpTo:"A\u017D \u2013{n} %"},en:{intro:"Hi, I'm **Jim**, your AI assistant at GymBeam.",welcome:"How can I help you?",welcomePdp:"I see you're looking at {product}. Want to know more about this product, or are you after something else?",welcomeCategory:"I'll help you choose. What's your goal \u2014 building muscle, losing weight, or overall health?",welcomeCart:"I see you have something in your cart. Want help choosing, or to add something that could help you?",welcomeAccount:"How can I help you?",welcomeBlog:"Want me to recommend products related to what you're reading?",chips:["Order status","Return goods","File a complaint","Cancel order","Product recommendations"],today:"Today",timeNow:"just now",timeMin:"{n} min ago",timeHour:"{n} h ago",rateAnswer:"Rate the answer",fbGood:"Good answer",fbBad:"Bad answer",disclaimer:"Jim is an AI assistant \xB7 it can make mistakes.",privacyLink:"Privacy Policy",placeholder:"Write a message to Jim\u2026",placeholderConsent:"Grant consent above to continue \u2191",gdprTitle:"Before we begin",gdprBody:"Jim uses AI to answer your questions. The conversation may be stored to improve the service. More in our {link}.",gdprLink:"privacy policy",gdprPending:"Your question: {q} \u2014 I'll send it as soon as you give consent.",gdprAccept:"Agree and start",gdprDecline:"Disagree",gdprDeclinedTitle:"We can't continue without consent",gdprDeclinedBody:"To chat with Jim, you need to consent to message processing. If you've changed your mind, you can give consent now.",gdprReset:"Give consent",panelRecommended:"Recommended products",addToCart:"Add to cart",priceFrom:"from",loadingPrice:"Loading\u2026",backToProducts:"Back to products",inStock:"In stock",pickVariant:"Select {opt}",orderPanelTitle:"Order",orderItems:"Items:",orderTotal:"Total:",addedToCart:"Added to cart",goToCart:"Go to cart",addedViaJim:"Added via Jim",discountUpTo:"UP TO \u2013{n} %"},de:{intro:"Hi, ich bin **Jim**, dein KI-Assistent von GymBeam.",welcome:"Wie kann ich dir helfen?",welcomePdp:"Ich sehe, du schaust dir {product} an. M\xF6chtest du mehr \xFCber dieses Produkt erfahren oder suchst du etwas anderes?",welcomeCategory:"Ich helfe dir bei der Auswahl. Was ist dein Ziel \u2014 Muskelaufbau, Abnehmen oder allgemeine Gesundheit?",welcomeCart:"Ich sehe, du hast etwas im Warenkorb. M\xF6chtest du Hilfe bei der Auswahl oder etwas Passendes erg\xE4nzen?",welcomeAccount:"Wie kann ich dir helfen?",welcomeBlog:"Soll ich dir Produkte passend zu dem empfehlen, was du gerade liest?",chips:["Bestellstatus","R\xFCc